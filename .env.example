# SAFETY: test first. Change to true only after reviewing dry-run logs.
LIVE_TRADING=false
MEXC_API_KEY=PASTE_MEXC_KEY
MEXC_API_SECRET=PASTE_MEXC_SECRET

# AI review. Failure or rejection = NO TRADE.
AI_MODE=REVIEW
OPENAI_API_KEY=PASTE_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
AI_MIN_CONFIDENCE=80

POSITION_NOTIONAL_USDT=200
LEVERAGE=25
LEVERAGE_RETRY_ATTEMPTS=5
LEVERAGE_RETRY_DELAY_SECONDS=2.0
MARGIN_MODE=isolated
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,BNB/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,ADA/USDT:USDT,DOGE/USDT:USDT,BCH/USDT:USDT,LINK/USDT:USDT,LTC/USDT:USDT,AVAX/USDT:USDT

FIB_SHALLOW=0.618
FIB_DEEP=0.79
REWARD_RISK=2.0
BREAK_EVEN_AT_R=1.5
STOP_BUFFER_BPS=2.0
EMA_SEPARATION_BPS=0.0

H1_PIVOT_LEFT=2
H1_PIVOT_RIGHT=2
M15_PIVOT_LEFT=2
M15_PIVOT_RIGHT=2
MAIN_SWING_MIN_ATR=1.75
MINIMUM_CANDIDATE_SCORE=80
MINIMUM_SWEEP_PCT=0.001
MIN_STOP_PCT=0.003
PREFERRED_MAX_STOP_PCT=0.015
MAX_STOP_PCT=0.03
MAX_CONFIRMATION_BARS_15M=40

POLL_SECONDS=20
HEARTBEAT_SECONDS=300
HISTORY_15M_BARS=2200
MAX_OPEN_POSITIONS=11
STATE_FILE=state.json
LOG_LEVEL=INFO

# MEXC market-data rate-limit protection
MARKET_DATA_RETRY_ATTEMPTS=5
MARKET_DATA_RETRY_DELAY_SECONDS=2.0
SYMBOL_REQUEST_DELAY_SECONDS=1.0
